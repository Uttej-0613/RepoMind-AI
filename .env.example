# Copy to .env only when using Docker Compose. Never commit your secrets.
# Absolute local folder containing source code, for example D:/Projects/StockAI
REPO_PATH=.
# Optional: protect API when not running on a fully trusted machine
REPOMIND_API_KEY=
# Optional: provide your hosted LLM key on the backend only
REPOMIND_LLM_API_KEY=
REPOMIND_LLM_MODEL=gpt-4o-mini
REPOMIND_LLM_URL=https://api.openai.com/v1/chat/completions
